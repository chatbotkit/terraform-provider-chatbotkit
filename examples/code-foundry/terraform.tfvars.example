# Copy to terraform.tfvars and fill in. The parent User API token comes from the
# CHATBOTKIT_API_TOKEN environment variable (not a variable here).
#
# Child Users are created out of band through the dashboard or User API.
# The shared User MUST have the alias `shared`.

shared_account_id = "user_xxxxxxxxxxxx" # the shared tools User (alias: shared)
alice_account_id  = "user_aaaaaaaaaaaa"
bob_account_id    = "user_bbbbbbbbbbbb"

github_app_id = "3555413"
git_email     = "agents@example.com"

# The GitHub App private key (PEM). Prefer an env var:
#   export TF_VAR_github_app_private_key="$(cat github-app.pem)"
# github_app_private_key = <<-EOT
# -----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----
# EOT
