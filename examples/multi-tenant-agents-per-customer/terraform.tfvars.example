# Child User IDs, one per customer.
#
# These select which child User each customer's module deploys into through run_as.
# They are User IDs, not secrets. The parent User API token is supplied
# separately via the CHATBOTKIT_API_TOKEN environment variable:
#
#   export CHATBOTKIT_API_TOKEN="sk-...your-parent-user-api-token..."
#
# Copy this file to terraform.tfvars and fill in the real User IDs.

acme_account_id   = "user_REPLACE-with-acme-user-id"
globex_account_id = "user_REPLACE-with-globex-user-id"
